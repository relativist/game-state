# For compose.yml: cp .env.example .env and replace password.
GAME_STATE_POSTGRES_PASSWORD=replace-with-random-password
# For npm start (Node does not load .env automatically):
DATABASE_URL=postgresql://game_state:replace-with-random-password@127.0.0.1:5432/game-state
PORT=3000
SESSION_DAYS=30
# Explicit additional browser origins, comma separated; no wildcard or null/file://.
CORS_ORIGINS=
TRUST_PROXY=0
